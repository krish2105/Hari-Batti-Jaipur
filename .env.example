# Copy to .env and edit. Never commit .env (it is gitignored).
# Local dev values only — these are not real secrets.

# Postgres + PostGIS (docker-compose.yml). Host port 5434 avoids Homebrew Postgres, which uses 5432 and 5433 on this Mac.
POSTGRES_USER=haribatti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=haribatti
POSTGRES_PORT=5434
DATABASE_URL=postgresql://haribatti:change-me@localhost:5434/haribatti

# Redis (live signal channel "signals"). Host port 6380 avoids Homebrew Redis on 6379.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Local Ollama for the dashboard AI Copilot (free, no paid APIs).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional: contact email sent to OpenStreetMap Nominatim by `make sim-coords` (their usage policy
# asks for one on heavy use). Leave blank to send none.
NOMINATIM_EMAIL=

# API sign-in (Signal Command dashboard). Set your own long random JWT_SECRET, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# There is no email service (zero paid APIs): the one-time code is printed in the API log.
# AUTH_DEV_ECHO_OTP=true also returns it to the login screen (development only).
AUTH_DEV_ECHO_OTP=true
AUTH_OPEN_SIGNUP=true
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Data connectors (P8 W12, read-only). Live feed: "sim" or a connector id from config/connectors.yaml
# (copy config/connectors.example.yaml). Try SIGNAL_SOURCE=demo-replay for the synthetic demo feed.
SIGNAL_SOURCE=sim
# CONNECTORS_FILE=config/connectors.yaml
# Secrets the YAML refers to by name (fill in only for a real feed):
ITMS_API_TOKEN=
ITMS_MQTT_USER=
ITMS_MQTT_PASSWORD=
