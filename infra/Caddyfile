# Caddy (P8 W18): automatic HTTPS (Let's Encrypt, ZeroSSL as fallback) for the dashboard and the API,
# WebSockets included. API_HOST and DASHBOARD_HOST come from infra/.env.production. The apps send their
# own security headers; Caddy adds compression and keeps 30 days of API access logs.

{$API_HOST} {
	encode zstd gzip
	reverse_proxy api:8000
	log {
		output file /data/access-api.log {
			roll_keep_for 720h
		}
	}
}

{$DASHBOARD_HOST} {
	encode zstd gzip
	reverse_proxy dashboard:3001
}
