# Production settings (copy to infra/.env.production on the server; never commit the real file).
API_HOST=api.example.in
DASHBOARD_HOST=dashboard.example.in
POSTGRES_PASSWORD=
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BACKUP_PASSPHRASE=
ADMIN_EMAILS=
CORS_ORIGINS=https://dashboard.example.in,https://hari-batti-jaipur.vercel.app
AUTH_DEV_ECHO_OTP=false
AUTH_OPEN_SIGNUP=false
WEB_CONCURRENCY=2
# Optional: alerts by email / Telegram (off when blank)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
