{
  "name": "hari-batti",
  "private": true,
  "description": "HariBatti — Jaipur signal countdown + audit platform (read-only; never controls a signal).",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:mobile": "pnpm --filter mobile start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
