# apps/web — all optional. Copy to apps/web/.env.local for local dev, or set in Vercel.
# Public site URL (canonical links, Open Graph).
NEXT_PUBLIC_SITE_URL=https://hari-batti-jaipur.vercel.app
# Live signals from the API WebSocket; leave blank to use the built-in simulated signals.
NEXT_PUBLIC_SIGNALS_WS=
# Contact address for the pilot button; blank = link to a GitHub issue instead.
NEXT_PUBLIC_CONTACT_EMAIL=
