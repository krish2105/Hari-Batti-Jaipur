    "expo": "~57.0.25",
    "expo-keep-awake": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2"
